<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="190dp" android:layout_height="145dp"
    android:layout_margin="8dp" android:orientation="vertical"
    android:focusable="true" android:clickable="true"
    android:background="#171717" android:padding="10dp">

    <ImageView android:id="@+id/channelLogo"
        android:layout_width="match_parent" android:layout_height="92dp"
        android:scaleType="fitCenter" android:contentDescription="Channel logo"/>

    <TextView android:id="@+id/channelTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="7dp" android:gravity="center"
        android:textColor="#FFFFFF" android:textSize="14sp"
        android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
